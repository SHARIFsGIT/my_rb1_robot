<?xml version="1.0" ?>
<robot name="rb1_robot">

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="gray"><color rgba="0.40 0.40 0.40 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>

  <!-- Base footprint at geometric center of bottom face -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <!-- base_link is centered in the cylinder; half-height = 0.15 m above footprint -->
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Base link: cylinder diameter 0.50 m (r=0.25), height 0.30 m -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.3"/></geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.3"/></geometry>
    </collision>

    <!-- Inertial for solid cylinder (mass = 22.0 kg) -->
    <!-- Ixx = Iyy = (1/12)*m*(3*r^2 + h^2) = 0.50875 -->
    <!-- Izz = (1/2)*m*r^2 = 0.6875 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="22.0"/>
      <inertia ixx="0.50875" ixy="0.0" ixz="0.0"
               iyy="0.50875" iyz="0.0" izz="0.6875"/>
    </inertial>
  </link>

  <!-- Left wheel (drive) -->
  <link name="left_wheel">
    <visual>
      <!-- rotate so cylinder axis aligns with wheel axle -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
    </collision>

    <!-- Inertial for small cylinder (mass = 0.5 kg) -->
    <!-- Ixx = Iyy = (1/12)*m*(3*r^2 + h^2) = 0.0001447916667 -->
    <!-- Izz = 0.5*m*r^2 = 0.00015625 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001447916667" ixy="0.0" ixz="0.0"
               iyy="0.0001447916667" iyz="0.0" izz="0.00015625"/>
    </inertial>
  </link>

  <joint name="base_link_left_wheel_joint" type="continuous">
    <!-- positioned at (0.0, 0.2, -0.15) relative to base_link -->
    <origin xyz="0.0 0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
  </joint>

  <!-- Right wheel (drive) -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0001447916667" ixy="0.0" ixz="0.0"
               iyy="0.0001447916667" iyz="0.0" izz="0.00015625"/>
    </inertial>
  </link>

  <joint name="base_link_right_wheel_joint" type="continuous">
    <!-- positioned at (0.0, -0.2, -0.15) relative to base_link -->
    <origin xyz="0.0 -0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
  </joint>

  <!-- Front caster (sphere, radius 0.025 m = 2.5 cm) -->
  <link name="front_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>

    <!-- Inertial for solid sphere (mass = 0.5 kg): I = (2/5)*m*r^2 = 0.000125 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000125" ixy="0.0" ixz="0.0"
               iyy="0.000125" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link>

  <joint name="base_link_front_caster_joint" type="fixed">
    <!-- front caster at (-0.1, 0.0, -0.15) -->
    <origin xyz="-0.1 0.0 -0.15" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_caster"/>
  </joint>

  <!-- Back caster (sphere) -->
  <link name="back_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000125" ixy="0.0" ixz="0.0"
               iyy="0.000125" iyz="0.0" izz="0.000125"/>
    </inertial>
  </link>

  <joint name="base_link_back_caster_joint" type="fixed">
    <!-- back caster at (0.1, 0.0, -0.15) -->
    <origin xyz="0.1 0.0 -0.15" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_caster"/>
  </joint>

  <!-- Front laser scanner: located at (0.25, 0.0, 0.075) rotated 180° around X (upside-down) -->
  <!-- Modeled as small cylinder: radius=0.03 m, length=0.06 m, mass=1.0 kg -->
  <link name="front_laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
    </collision>

    <!-- Inertial (mass=1.0 kg): Ixx = Iyy = 0.000525 ; Izz = 0.00045 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000525" ixy="0.0" ixz="0.0"
               iyy="0.000525" iyz="0.0" izz="0.00045"/>
    </inertial>
  </link>

  <joint name="base_link_front_laser_joint" type="fixed">
    <origin xyz="0.25 0.0 0.075" rpy="3.14159 0 0"/>
    <parent link="base_link"/>
    <child link="front_laser"/>
  </joint>

  <!-- Gazebo friction overrides for casters: set friction to 0.0 -->
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <surface>
      <friction>
        <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="back_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <surface>
      <friction>
        <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
      </friction>
    </surface>
  </gazebo>


<!-- GAZEBO CLASSIC PLUGINS AND PROPERTIES -->

  <!-- Gazebo color for base_link (Black) -->
  <gazebo reference="base_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Friction for wheels -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Casters with zero friction -->
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="back_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Differential Drive Plugin for Gazebo Classic -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <updateRate>30</updateRate>
      <leftJoint>base_link_left_wheel_joint</leftJoint>
      <rightJoint>base_link_right_wheel_joint</rightJoint>
      <wheelSeparation>0.4</wheelSeparation>
      <wheelDiameter>0.05</wheelDiameter>
      <wheelAcceleration>1.0</wheelAcceleration>
      <wheelTorque>10</wheelTorque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>

  <!-- Laser Scanner Plugin for Gazebo Classic -->
  <gazebo reference="front_laser">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
        <frameName>front_laser</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>